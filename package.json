{
  "name": "summit-scene-ai-upgrade",
  "version": "1.0.10",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "configure:app-updates": "node scripts/configureAppUpdates.mjs",
    "build:website": "node scripts/buildWebsite.mjs",
    "preview:website": "node scripts/previewWebsite.mjs",
    "test:website": "mocha --exit --timeout 10000 server/test/publicWebsite.test.js",
    "test:event-importer": "mocha --exit --timeout 10000 server/test/eventImporter.test.js server/test/eventCategory.test.js server/test/eventImportRejection.test.js server/test/eventImportApproval.test.js server/test/eventImporterReliability.test.js server/test/eventImportBulkRejection.test.js server/test/eventImportJobs.test.js",
    "test:app-usage": "mocha --exit --timeout 10000 server/test/appUsage.test.js",
    "test:app-updates": "mocha --exit --timeout 10000 server/test/appUpdate.test.js server/test/appUpdateSetup.test.js",
    "start": "expo start",
    "start:clear": "expo start --clear",
    "start:tunnel": "expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "import-events": "npm --prefix server run import-events",
    "cleanup:admin-analytics": "npm --prefix server run cleanup:admin-analytics",
    "seed:event-sources": "npm --prefix server run seed:event-sources",
    "backfill:analytics-attribution": "npm --prefix server run backfill:analytics-attribution",
    "repair:imported-event-ranges": "npm --prefix server run repair:imported-event-ranges",
    "repair:imported-event-compliance": "npm --prefix server run repair:imported-event-compliance"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.8.4",
    "@react-navigation/native": "^7.1.19",
    "@react-navigation/native-stack": "^7.6.3",
    "expo": "^57.0.28",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "~57.0.3",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-image-picker": "~57.0.20",
    "expo-location": "~57.0.21",
    "expo-notifications": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.0"
  },
  "private": true,
  "devDependencies": {
    "chai": "^6.2.1",
    "mingo": "^7.2.5",
    "mocha": "^11.7.5",
    "supertest": "^7.1.4"
  }
}
