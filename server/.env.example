MONGODB_URI=YOUR_MONGODB_ATLAS_URI_HERE
PORT=4000
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=90d
OPENAI_API_KEY=your-openai-api-key-here
EMAIL_DELIVERY_ENABLED=false
APP_PUBLIC_URL=https://summitscene.ca
MODERATION_NOTIFICATION_EMAIL=hello@summitscene.ca
EMAIL_FROM=Summit Scene <no-reply@summitscene.ca>
# Use either Resend or SMTP for email delivery.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
GEOCODING_USER_AGENT=SummitScene/1.0 (contact@yourdomain.com)
GEOCODING_EMAIL=contact@yourdomain.com
FACEBOOK_APP_ID=YOUR_FACEBOOK_APP_ID
FACEBOOK_APP_SECRET=YOUR_FACEBOOK_APP_SECRET
FACEBOOK_APP_REDIRECT_URI=summitscene://auth/facebook

# Account provider validation. The Web client ID must match the app build.
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_OAUTH_CLIENT_ID.apps.googleusercontent.com
APPLE_BUNDLE_ID=com.rachellauren.summitscene
# Server-only Sign in with Apple key for token exchange and account deletion.
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_KEY_ID=YOUR_SIGN_IN_WITH_APPLE_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_P8_KEY_CONTENTS\n-----END PRIVATE KEY-----"
PUSH_NOTIFICATIONS_ENABLED=true
DAILY_EVENTS_JOB_INTERVAL_MS=900000
